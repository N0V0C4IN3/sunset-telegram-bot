TELEGRAM_BOT_TOKEN=replace-me

POSTGRES_DB=sunset_bot
POSTGRES_USER=sunset_bot
# Generate one, e.g. `openssl rand -hex 24`. Compose refuses to start without it.
# The same value has to appear inside DATABASE_URL below.
POSTGRES_PASSWORD=replace-with-a-generated-password
DATABASE_URL=postgresql+asyncpg://sunset_bot:replace-with-a-generated-password@postgres:5432/sunset_bot
LOCATION_ENCRYPTION_KEY=replace-with-a-long-random-secret
SUNSETHUE_API_KEY=
SUNSETHUE_FALLBACK_API_KEY=

NOTIFICATION_SCAN_INTERVAL_MINUTES=30
DEFAULT_NOTIFICATION_THRESHOLD=70
DEFAULT_NOTIFICATION_LEAD_TIME_MINUTES=90
FORECAST_CACHE_TTL_MINUTES=300
FORECAST_CACHE_RETENTION_DAYS=7
LOG_LEVEL=INFO
